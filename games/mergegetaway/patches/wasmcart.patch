diff --git a/ld50/cars/car_main.script b/ld50/cars/car_main.script
index 259af0e..90954ee 100755
--- a/ld50/cars/car_main.script
+++ b/ld50/cars/car_main.script
@@ -136,11 +136,11 @@ local function process_input(self, dt)
 
     self.no_input_time = self.no_input_time + dt
 
-    if self.input_key_left or self.input_key_left2 then
+    if self.input_key_left or self.input_key_left2 or self.input_pad_left or self.input_stick_left then
         sx = sx - 1
         self.no_input_time = 0
     end
-    if self.input_key_right or self.input_key_right2 then
+    if self.input_key_right or self.input_key_right2 or self.input_pad_right or self.input_stick_right then
         sx = sx + 1
         self.no_input_time = 0
     end
@@ -558,5 +558,14 @@ function on_input(self, action_id, action)
         self.input_key_left2 = not action.released
     elseif action_id == self.key_right2 then
         self.input_key_right2 = not action.released
+    -- Gamepad: the d-pad and the left stick steer like the arrow keys.
+    elseif action_id == hash("gamepad_lpad_left") then
+        self.input_pad_left = not action.released
+    elseif action_id == hash("gamepad_lpad_right") then
+        self.input_pad_right = not action.released
+    elseif action_id == hash("gamepad_lstick_left") then
+        self.input_stick_left = not action.released and action.value > 0.3
+    elseif action_id == hash("gamepad_lstick_right") then
+        self.input_stick_right = not action.released and action.value > 0.3
     end
 end
