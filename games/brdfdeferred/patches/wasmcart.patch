@@ -35,8 +35,23 @@ function World:new(init_callback, update_callback)
 		ambient_color = vmath.vector4(0.1, 0.1, 0.1, 1),
 		
 		init = function(this)
-			physics.set_listener(function(_, event, data)
-				this.physics_master:update(event, data)
+		end,
+
+		-- Defold 1.13 replaced the per-event physics listener, fn(self, event, data),
+		-- with set_event_listener, fn(self, events): one call per frame with
+		-- every event, each tagged by its "type" field. It binds the calling
+		-- script's physics world and errors where there is none, so it is set
+		-- from the first subscriber, which lives in the loaded world, rather
+		-- than at construction in the bootstrap collection.
+		listen_for_physics = function(this)
+			if this.physics_listening then
+				return
+			end
+			this.physics_listening = true
+			physics.set_event_listener(function(_, events)
+				for _, event in ipairs(events) do
+					this.physics_master:update(event.type, event)
+				end
 			end)
 		end,
 
