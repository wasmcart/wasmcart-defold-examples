emitters {
  id: "emitter"
  mode: PLAY_MODE_LOOP
  duration: 3.0
  space: EMISSION_SPACE_WORLD
  position { x: 0.0 y: 0.0 z: 0.0 }
  rotation { x: 0.0 y: 0.0 z: 0.0 w: 1.0 }
  tile_source: "/main/sprites.atlas"
  animation: "white"
  material: "/builtins/materials/sprite.material"
  blend_mode: BLEND_MODE_ADD
  particle_orientation: PARTICLE_ORIENTATION_DEFAULT
  inherit_velocity: 0.0
  max_particle_count: 256
  type: EMITTER_TYPE_CIRCLE
  start_delay: 0.0
  properties { key: EMITTER_KEY_SPAWN_RATE points { x: 0.0 y: 120.0 t_x: 1.0 t_y: 0.0 } }
  properties { key: EMITTER_KEY_SIZE_X points { x: 0.0 y: 40.0 t_x: 1.0 t_y: 0.0 } }
  properties { key: EMITTER_KEY_PARTICLE_LIFE_TIME points { x: 0.0 y: 2.0 t_x: 1.0 t_y: 0.0 } }
  properties { key: EMITTER_KEY_PARTICLE_SPEED points { x: 0.0 y: 180.0 t_x: 1.0 t_y: 0.0 } }
  properties { key: EMITTER_KEY_PARTICLE_SIZE points { x: 0.0 y: 12.0 t_x: 1.0 t_y: 0.0 } }
  particle_properties { key: PARTICLE_KEY_SCALE points { x: 0.0 y: 1.0 t_x: 1.0 t_y: 0.0 } points { x: 1.0 y: 0.2 t_x: 1.0 t_y: 0.0 } }
  particle_properties { key: PARTICLE_KEY_ALPHA points { x: 0.0 y: 1.0 t_x: 1.0 t_y: 0.0 } points { x: 1.0 y: 0.0 t_x: 1.0 t_y: 0.0 } }
}
