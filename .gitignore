# bob's content build output, regenerated by build-cart.sh
build/
*/build/
.internal/
*/.internal/

# packed carts and their save blocks: build artifacts, not sources
*.wasc
*.sav

# bombfrog is third-party content with no licence file in the tree. It stays
# on disk as a render test on real assets, but is NOT committed until its
# origin and licence are confirmed.
bombfrog/

# Each project needs a builtins/ link into the engine tree. It is an absolute
# path to wherever the engine was cloned, so it is created by build-cart.sh at
# build time rather than committed.
builtins

# Ported third-party games are staged locally but NOT committed until the
# provenance of their bundled audio is established: the upstream MIT LICENSE
# covers Ben James, while title screens credit other musicians by name.
substrike/
planetoid/
pixelcrypt/
snowline/
defrog/
